# Only needed for a real `pdf-redpen review` (demo, apply, clear and --mock need none of this).
# Load with:  set -a; source .env; set +a
PDF_REDPEN_BASE_URL=http://localhost:11434/v1
PDF_REDPEN_MODEL=
PDF_REDPEN_API_KEY=
PDF_REDPEN_TIMEOUT=120
# Screen language: en or ko (empty = follow the locale)
PDF_REDPEN_LANG=
